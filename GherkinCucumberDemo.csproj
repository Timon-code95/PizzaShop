<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="PizzaShop.Domain\PizzaShop.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude sibling projects' source files: they live under this solution's root folder,
         so the default SDK-style glob (**/*.cs) would otherwise pull them into this project too. -->
    <Compile Remove="PizzaShop.Domain\**\*.cs" />
    <Compile Remove="PizzaShop.Bdd.Tests\**\*.cs" />
  </ItemGroup>

</Project>
